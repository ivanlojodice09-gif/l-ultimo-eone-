<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#080909">
  <meta name="description" content="LAST EON — Wildland Revolution. Un’esperienza digitale immersiva e open source.">
  <title>LAST EON — Wildland Revolution</title>

  <style>
    :root {
      color-scheme: dark;
      --bg: #080909;
      --panel: rgba(255, 255, 255, .035);
      --text: #ecece6;
      --muted: #a4a69e;
      --line: rgba(236, 236, 230, .17);
      --accent: #c8ff6a;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background:
        radial-gradient(ellipse at 75% 12%, rgba(120, 150, 80, .16), transparent 38%),
        radial-gradient(ellipse at 10% 45%, rgba(100, 120, 180, .10), transparent 36%),
        var(--bg);
      color: var(--text);
      font: 16px/1.65 Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    a { color: inherit; }
    .wrap { width: min(1080px, calc(100% - 40px)); margin-inline: auto; }

    header {
      position: sticky;
      top: 0;
      z-index: 2;
      background: rgba(8, 9, 9, .88);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(12px);
    }

    .nav {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand, nav a {
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: .13em;
      font-size: .75rem;
    }

    .brand { font-weight: 800; }
    nav { display: flex; flex-wrap: wrap; gap: 18px; }
    nav a { color: var(--muted); }

    .hero {
      min-height: 70vh;
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      align-items: center;
      gap: 36px;
      padding-block: 80px;
    }

    .eyebrow {
      display: block;
      margin-bottom: 14px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: .16em;
      font-size: .72rem;
    }

    h1 {
      margin: 0;
      font-size: clamp(3.5rem, 11vw, 7.5rem);
      line-height: .88;
      letter-spacing: -.075em;
    }

    h2 {
      margin: 0 0 16px;
      font-size: clamp(1.8rem, 4vw, 3rem);
      line-height: 1.08;
      letter-spacing: -.045em;
    }

    h3 { margin: 0 0 10px; }
    p { margin: 0; }
    .lead { max-width: 650px; margin-top: 22px; color: #c6c8c0; font-size: 1.12rem; }
    .muted, .caption { color: var(--muted); }

    .hero-card, .card, .stat, .panel, .control {
      border: 1px solid var(--line);
      background: var(--panel);
      border-radius: 14px;
    }

    .hero-card { padding: 24px; }
    .cycle { color: var(--accent); font-size: 1.08rem; letter-spacing: .08em; }
    .motto { margin-top: 20px; color: var(--muted); }

    section { padding-block: 68px; border-top: 1px solid var(--line); }
    .stats, .cards { display: grid; gap: 16px; }
    .stats { grid-template-columns: repeat(4, 1fr); margin-top: 26px; }
    .cards { grid-template-columns: repeat(3, 1fr); margin-top: 24px; }
    .stat, .card, .panel { padding: 22px; }
    .stat-value { font-size: 1.35rem; font-weight: 700; }
    .stat-label { margin-top: 8px; color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; }
    .card p, .panel p { color: var(--muted); }

    .graph-layout { display: grid; grid-template-columns: 1.2fr .8fr; gap: 24px; align-items: start; }
    canvas {
      display: block;
      width: 100%;
      height: 280px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: rgba(255, 255, 255, .02);
    }

    .controls { display: grid; gap: 12px; }
    .control { padding: 14px; }
    .control label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; font-size: .82rem; }
    .control small { display: block; margin-top: 5px; color: var(--muted); }
    input[type="range"] { width: 100%; accent-color: var(--accent); }
    .chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; }
    .chip { border: 1px solid var(--line); border-radius: 99px; padding: 6px 11px; color: var(--muted); font-size: .75rem; }
    .caption { margin-top: 12px; font-size: .88rem; }

    footer { padding-block: 28px 42px; color: var(--muted); font-size: .88rem; }
    .error { padding: 14px; border: 1px solid #ff8a8a; border-radius: 10px; color: #ffd0d0; }

    @media (max-width: 760px) {
      .hero, .graph-layout { grid-template-columns: 1fr; }
      .hero { min-height: auto; padding-block: 70px; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .cards { grid-template-columns: 1fr; }
    }

    @media (max-width: 480px) {
      .wrap { width: min(100% - 28px, 1080px); }
      .nav { align-items: flex-start; flex-direction: column; padding-block: 14px; }
      nav { gap: 12px; }
      .stats { grid-template-columns: 1fr; }
      section { padding-block: 48px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
    }
  </style>
</head>

<body>
  <header>
    <div class="wrap nav">
      <a class="brand" href="#">LAST EON</a>
      <nav aria-label="Navigazione principale">
        <a href="#concept">Concept</a>
        <a href="#ricerca">Ricerca</a>
        <a href="#visual">Visualizzazione</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap hero">
      <div>
        <span class="eyebrow" id="eyebrow">Esperienza digitale immersiva</span>
        <h1 id="title">LAST EON</h1>
        <p class="lead" id="description">Caricamento del progetto…</p>
      </div>
      <aside class="hero-card" aria-label="Ciclo del progetto">
        <span class="eyebrow">Il ciclo</span>
        <p class="cycle">STASI → ESTASI → CAOS → DECADIMENTO → STASI</p>
        <p class="motto">One Face · One Race · Free Knowledge</p>
      </aside>
    </section>

    <section id="concept">
      <div class="wrap">
        <span class="eyebrow">In breve</span>
        <h2>Un ecosistema in trasformazione.</h2>
        <div class="stats" id="stats"></div>
      </div>
    </section>

    <section id="ricerca">
      <div class="wrap">
        <div class="panel">
          <span class="eyebrow">La ricerca</span>
          <h2 id="story-title">Tra dato, ambiente e percezione</h2>
          <p id="story-text"></p>
        </div>
        <div class="cards" id="applications"></div>
      </div>
    </section>

    <section id="visual">
      <div class="wrap">
        <div class="graph-layout">
          <div>
            <span class="eyebrow">Visualizzazione dimostrativa</span>
            <h2>Una curva generativa.</h2>
            <canvas id="graph" aria-label="Grafico generativo dimostrativo"></canvas>
            <p class="caption" id="graph-caption"></p>
          </div>
          <div>
            <span class="eyebrow">Controlli</span>
            <h2>Modifica la forma.</h2>
            <div class="controls" id="controls"></div>
          </div>
        </div>

        <div class="panel" style="margin-top:24px">
          <span class="eyebrow">Principi</span>
          <div class="cards" id="principles"></div>
        </div>

        <div style="margin-top:24px">
          <span class="eyebrow">Strumenti e direzioni esplorative</span>
          <div class="chips" id="stack"></div>
        </div>

        <div class="panel" style="margin-top:24px">
          <h3 id="note-title"></h3>
          <p id="note-text"></p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap" id="footer"></div>
  </footer>

  <script>
    const values = {};

    function addTextCard(parent, title, text, className = "card") {
      const card = document.createElement("article");
      card.className = className;

      const heading = document.createElement("h3");
      heading.textContent = title || "";

      const paragraph = document.createElement("p");
      paragraph.textContent = text || "";

      card.append(heading, paragraph);
      parent.append(card);
    }

    function render(data) {
      document.title = `${data.site?.title || "LAST EON"} — ${data.site?.tagline || ""}`;
      document.getElementById("title").textContent = data.site?.title || "LAST EON";
      document.getElementById("eyebrow").textContent = data.hero?.eyebrow || "";
      document.getElementById("description").textContent = data.hero?.description || "";
      document.getElementById("story-title").textContent = data.story?.title || "";
      document.getElementById("story-text").textContent = data.story?.text || "";
      document.getElementById("graph-caption").textContent = data.graph?.caption || "";
      document.getElementById("note-title").textContent = data.note?.title || "";
      document.getElementById("note-text").textContent = data.note?.text || "";
      document.getElementById("footer").textContent = data.footer || "";

      const stats = document.getElementById("stats");
      (data.stats || []).forEach(item => {
        const card = document.createElement("article");
        card.className = "stat";

        const value = document.createElement("div");
        value.className = "stat-value";
        value.textContent = item.value || "";

        const label = document.createElement("div");
        label.className = "stat-label";
        label.textContent = item.label || "";

        card.append(value, label);
        stats.append(card);
      });

      (data.applications || []).forEach(item =>
        addTextCard(document.getElementById("applications"), item.title, item.text)
      );

      (data.ontology?.principles || []).forEach(item =>
        addTextCard(document.getElementById("principles"), item.title, item.text)
      );

      (data.stack || []).forEach(text => {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.textContent = text;
        document.getElementById("stack").append(chip);
      });

      (data.controls || []).forEach(control => {
        values[control.id] = Number(control.value);

        const box = document.createElement("div");
        box.className = "control";

        const label = document.createElement("label");
        const name = document.createElement("span");
        name.textContent = control.label;

        const output = document.createElement("strong");
        output.textContent = Number(control.value).toFixed(2);
        label.append(name, output);

        const input = document.createElement("input");
        input.type = "range";
        input.min = control.min;
        input.max = control.max;
        input.step = control.step;
        input.value = control.value;
        input.setAttribute("aria-label", control.label || control.id);

        const help = document.createElement("small");
        help.textContent = control.operator || "";

        input.addEventListener("input", () => {
          values[control.id] = Number(input.value);
          output.textContent = Number(input.value).toFixed(2);
          drawGraph();
        });

        box.append(label, input, help);
        document.getElementById("controls").append(box);
      });

      drawGraph();
    }

    function drawGraph() {
      const canvas = document.getElementById("graph");
      const rect = canvas.getBoundingClientRect();
      if (!rect.width) return;

      const ratio = window.devicePixelRatio || 1;
      canvas.width = Math.round(rect.width * ratio);
      canvas.height = Math.round(280 * ratio);

      const ctx = canvas.getContext("2d");
      ctx.scale(ratio, ratio);

      const width = rect.width;
      const height = 280;
      const intensity = values.intensity ?? 0.62;
      const frequency = values.frequency ?? 2.4;
      const constance = values.constance ?? 0.72;

      ctx.clearRect(0, 0, width, height);

      ctx.strokeStyle = "rgba(200,255,106,.13)";
      ctx.lineWidth = 1;
      for (let y = 35; y < height; y += 52) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }

      ctx.beginPath();
      for (let x = 0; x <= width; x++) {
        const t = x / width;
        const wave =
          Math.sin(t * Math.PI * 2 * frequency) * (0.25 + intensity * 0.7) +
          Math.sin(t * Math.PI * 5 * (1 + constance)) * (0.18 + intensity * 0.25);
        const y = height / 2 + wave * 75;

        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }

      ctx.strokeStyle = "#c8ff6a";
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    async function start() {
      try {
        const response = await fetch("./project.json");
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        render(data);
      } catch (error) {
        document.querySelector("main").innerHTML =
          '<div class="wrap" style="padding:60px 0"><p class="error">Non riesco a caricare project.json. Controlla che il file sia nella stessa cartella di index.html e che il nome sia scritto esattamente così.</p></div>';
        console.error("Errore nel caricamento di project.json:", error);
      }
    }

    window.addEventListener("resize", drawGraph);
    start();
  </script>
</body>
</html>